# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > Database > Connection string
# Pooled (transaction mode, port 6543) for the app on Vercel:
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct (session mode, port 5432) for migrations:
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API keys (the publishable or anon key goes in ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KoboToolbox: each project connects its own account, forms and automatic sync in Setup.
# No Kobo token or form ID goes here. Encrypts each project's KoboToolbox API token in the database (set in project setup).
# 32 random bytes, base64: openssl rand -base64 32. Changing it makes saved tokens unreadable.
KOBO_TOKEN_KEY=
# Submissions attach to the project named in each form's hidden project_code.

# Sign-in. Leave DEMO_SIGN_IN empty for real sign-in (emailed one-time codes).
# Set it to 1 for the people picker: laptops and demo copies on fictional data only.
DEMO_SIGN_IN=
# Supabase > Project Settings > API keys > secret key. Server only; used by `npm run staff -- add`.
SUPABASE_SERVICE_ROLE_KEY=

# AI drafting of procurement documents (RFQ, solicitation, sole source justification). Server only.
ANTHROPIC_API_KEY=
