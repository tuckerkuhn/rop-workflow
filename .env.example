# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > Database > Connection string
# Pooled (transaction mode, port 6543) for the app on Vercel:
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct (session mode, port 5432) for migrations:
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KoboToolbox (global server)
KOBO_SERVER_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=
# Basic-auth credentials you set on the Kobo REST Service
KOBO_WEBHOOK_USER=
KOBO_WEBHOOK_PASSWORD=
# Project that incoming Kobo submissions attach to (MVP: single project)
DEFAULT_PROJECT_ID=
