# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > Database > Connection string
# Pooled (transaction mode, port 6543) for the app on Vercel:
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct (session mode, port 5432) for migrations:
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API keys (the publishable or anon key goes in ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KoboToolbox: each project connects its own account, forms and automatic sync in Setup.
# No Kobo token or form ID goes here. Encrypts each project's KoboToolbox API token in the database (set in project setup).
# 32 random bytes, base64: openssl rand -base64 32. Changing it makes saved tokens unreadable.
KOBO_TOKEN_KEY=
# Submissions attach to the project named in each form's hidden project_code.

# One shared password for the whole site (the browser asks once; any username). Empty = no password.
# Set it on any copy that is online. Kobo's webhook and donor share links do not need it.
SITE_PASSWORD=

# Sign-in. Leave DEMO_SIGN_IN empty for real sign-in (emailed one-time codes).
# Set it to 1 for the people picker: laptops and demo copies on fictional data only.
DEMO_SIGN_IN=
# Supabase > Project Settings > API keys > secret key. Server only; used by `npm run staff -- add`.
SUPABASE_SERVICE_ROLE_KEY=

# AI drafting of procurement documents (RFQ, solicitation, sole source justification). Server only.
ANTHROPIC_API_KEY=

# Email (Resend). Without RESEND_API_KEY nothing is emailed: an approver learns of an input
# distribution only when they next open Home, and the record says "Not emailed" with the reason.
# Set it wherever approvals must be instant, the Jan 10 demo included. Server only.
RESEND_API_KEY=
# The address emails come from. Empty uses the app's default sender.
NOTIFY_FROM=
# The app's own address, for links in emails sent outside a request (a KoboToolbox sync, the
# nightly jobs). Empty uses the Vercel production address, or http://localhost:3000 on a laptop.
APP_URL=
# Shared secret for the scheduled jobs in vercel.json (daily email, HR seal, Kobo reconcile).
# Without it they are refused. openssl rand -base64 32
CRON_SECRET=

# Demo mode only: approval emails meant for the fictional people go to this address instead.
NOTIFY_TEST_TO=

# Where proof photos are kept (server/file-store). "inline" (default): inside the records, as
# before. "supabase": a private bucket in Supabase Storage (free plan), only fingerprints in the
# records. Uses NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above.
PROOF_FILE_STORE=inline
PROOF_FILE_BUCKET=proof-files
